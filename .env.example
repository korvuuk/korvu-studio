# Copie para .env e preencha. O .env nunca vai para o git (está no .gitignore).
# Nenhum valor aqui é segredo: são só os nomes das variáveis e exemplos.

# Quem publica (aparece no PDF da palavra-chave, no painel e nas respostas automáticas)
CONTA_INSTAGRAM=@sua_conta

# Binários (ffmpeg estático com libass/zimg recomendado; o do Homebrew também serve)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Captação (o padrão do projeto: 25 fps, câmera em V-Log 10-bit)
FPS_PROJETO=25
CAMERA_PERFIL=vlog

# Transcrição, música e efeitos sonoros (ElevenLabs) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Geração de imagem (skill gerar-imagem). Basta uma das duas.
# motores teste e gemini (Gemini 3.1 Flash Image via OpenRouter)
OPENROUTER_API_KEY=
# motor openai (gpt-image-2)
OPENAI_API_KEY=

# Publicação no Instagram e na Página do Facebook (automacao-meta/CONFIGURAR-APP-META.md)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0

# Cloudflare R2 (URL pública do vídeo/capa/PDF que a API da Meta baixa)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Fuso do calendário de publicação (nome IANA). Sem valor = UTC.
TZ_PUBLICACAO=America/Sao_Paulo

# Painel web (painel/web/.env.local) — as mesmas informações, vistas pelo navegador
# NEXT_PUBLIC_CONTA_INSTAGRAM=@sua_conta
# NEXT_PUBLIC_TZ_PUBLICACAO=America/Sao_Paulo
