    },
    {
      "camada": "agentes",
      "tecnologia": "Claude Code (subagentes opus)",
      "versao": null,
      "fonte": ".claude/agents/*.md"
    },
    {
      "camada": "ajuste fino",
      "tecnologia": "DaVinci Resolve (FCPXML + MCP)",
      "versao": null,
      "fonte": "corte-por-roteiro/SKILL.md"
    }
  ],
  "pipeline": [
    {
      "etapa": "Pauta",
      "quem": "estrategista (/ideias)",
      "entra": "notícias + _controle/aprendizados.md",
      "sai": "01-ideias/",
      "portao": "PAUTA"
    },
    {
      "etapa": "Roteiro",
      "quem": "roteirista → dramaturgo",
      "entra": "tema",
      "sai": "roteiro.md",
      "portao": "ROTEIRO"
    },
    {
      "etapa": "PDF da palavra-chave",
      "quem": "produtor-de-material (gerar_material_pdf.py)",
      "entra": "roteiro + fontes",
      "sai": "material/<arquivo>.pdf",
      "portao": "ROTEIRO"
    },
    {
      "etapa": "Material em vídeo",
      "quem": "buscador-de-videos / curador-de-obra (yt-dlp)",
      "entra": "roteiro",
      "sai": "material/youtube/catalogo.*, brutos/extras/",
      "portao": "PAUTA"
    },
    {
      "etapa": "Formatos de leitura",
      "quem": "skill roteiro-reels",
      "entra": "roteiro",
      "sai": "teleprompter.txt, monitor-chatgpt.txt, historia-completa.txt",
      "portao": null
    },
    {
      "etapa": "Cenas extras e animação",
      "quem": "produtor-de-extras, animador (Claude Design → Remotion)",
      "entra": "roteiro",
      "sai": "brutos/extras/, composições Remotion",
      "portao": "IMAGEM"
    },
    {
      "etapa": "Gravação",
      "quem": "apresentador (método ChatGPT monitor)",
      "entra": "teleprompter/monitor",
      "sai": "brutos/principal/",
      "portao": null
    },
    {
      "etapa": "Edição",
      "quem": "editor-de-video (/editar)",
      "entra": "brutos",
      "sai": "edl.json + preview.mp4",
      "portao": "aprovação humana da EDL"
    },
    {
      "etapa": "Corte + legendas",
      "quem": "render_corte.py, verify.py, gerar_props.py",
      "entra": "EDL aprovada",
      "sai": "corte.mp4, legendas.json/.srt",
      "portao": "revisão 1 (revisor-de-video)"
    },
    {
      "etapa": "Cor",
      "quem": "colorista (/cor)",
      "entra": "corte.mp4 (V-Log)",
      "sai": "edicao/cor/corte-cor.mp4",
      "portao": "IMAGEM"
    },
    {
      "etapa": "Gráficos",
      "quem": "Remotion (render_reel.py)",
      "entra": "reel-props.json",
      "sai": "render-remotion.mp4",
      "portao": null
    },
    {
      "etapa": "Música + áudio",
      "quem": "produtor-musical (ElevenLabs Music) + audio.py",
      "entra": "render-remotion.mp4 + corte-audio.wav",
      "sai": "final.mp4 (−14 LUFS)",
      "portao": "CORTE"
    },
    {
      "etapa": "Capa",
      "quem": "designer-de-capas",
      "entra": "corte com cor",
      "sai": "capa/capa*.png",
      "portao": "IMAGEM"
    },
    {
      "etapa": "QA final",
      "quem": "revisor-de-video passagem 2 + qa_check.py",
      "entra": "final.mp4",
      "sai": "qa/relatorio.md",
      "portao": "CORTE"
    },
    {
      "etapa": "Pacote",
      "quem": "montar_pacote.py",
      "entra": "tudo aprovado",
      "sai": "05-render-pronto/<slug>/ + selo",
      "portao": "exige pauta/roteiro/imagem/corte"
    },
    {
      "etapa": "Fila e agenda",
      "quem": "publicador (/publicar) + publicar.py agendar",
      "entra": "pacote",
      "sai": "06-publicar/<slug>/post.json + legendas",
      "portao": "PUBLICACAO"
    },
    {
      "etapa": "Publicação",
      "quem": "publicar.py --due (launchd 15 min)",
      "entra": "06-publicar/",
      "sai": "IG + FB, 07-publicados/<slug>/",
      "portao": "confere selo + PUBLICACAO"
    },
    {
      "etapa": "Material no direct",
      "quem": "responder_comentarios.py (launchd 2 min)",
      "entra": "dm-material.json",
      "sai": "direct + resposta pública, estado.json",
      "portao": null
    },
    {
      "etapa": "Métricas",
      "quem": "metricas.py (launchd 09:30) → analista-de-metricas",
      "entra": "insights",
      "sai": "metricas.json → _controle/aprendizados.md",
      "portao": null
    },
    {
      "etapa": "Acertos",
      "quem": "acertos.py → multiplicador-de-acertos (/multiplicar)",
      "entra": "métricas",
      "sai": "série de ideias",
      "portao": "PAUTA"
    }
  ],
  "edicao": [
    {
      "passo": 1,
      "nome": "Ingestão",
      "script": "corte-por-roteiro/scripts/ingest.py",
      "sai": "edicao/fontes/*.mp4 (1440×2560, H.264 high422 yuv422p10le CRF 12, ainda V-Log) + audio48k/*.wav (48 kHz 24-bit mono, highpass 60 Hz, sem redução de ruído)",
      "fonte": "ingest.py, common.py"
    },
    {
      "passo": 2,
      "nome": "Transcrição",
      "script": "corte-por-roteiro/scripts/transcribe.py",
      "sai": "edicao/transcricao.json",
      "detalhe": "Scribe v2 (language_code=por, timestamps word, diarize, num_speakers=2, até 100 keyterms); sem chave → mlx-whisper-large-v3-turbo",
      "fonte": "transcribe.py"
    },
    {
      "passo": 3,
      "nome": "Locutores",
      "script": "corte-por-roteiro/scripts/locutores.py",
      "sai": "locutores.json (zonas_ia)",
      "detalhe": "diarização do Scribe + análise acústica local (graves, nível, centróide, pitch) → k-means 2 classes → HMM",
      "fonte": "locutores.py"
    },
    {
      "passo": 4,
      "nome": "Alinhamento + escolha do take",
      "script": "corte-por-roteiro/scripts/align.py",
      "sai": "alinhamento.json",
      "parametros": {
        "GAP_TAKE_s": 1.5,
        "SIM_OK": 0.8,
        "SIM_PARAFRASE": 0.45,
        "COB_IMPROVISO": 0.55,
        "CONF_MIN": 0.6,
        "PAUSA_INTERNA_flag_s": 0.7,
        "PESOS": {
          "sim": 0.55,
          "cobertura": 0.15,
          "fluencia": 0.1,
          "recencia": 0.1,
          "confianca": 0.1
        }
      },
      "detalhe": "escolhido = último take limpo (sim ≥ 0,80 sem false_start/recomeco/final_cortado/sobreposicao_ia)",
      "fonte": "align.py linhas 33–66, função escolher"
    },
    {
      "passo": 5,
      "nome": "EDL",
      "script": "corte-por-roteiro/scripts/edl.py",
      "sai": "edl.json, edl.md, preview.mp4 (540×960), resolve/<slug>.fcpxml",
      "parametros": {
        "PRE_s": 0.06,
        "POS_s": 0.08,
        "PAUSA_ALVO_s": {
          "normal": 0.08,
          "pausa": 0.45,
          "pausa_longa": 0.75
        },
        "SNAP_s": 0.06,
        "GUARDA_ENERGIA_s": 0.04,
        "PAUSA_INTERNA_s": 0.25,
        "PAUSA_RESTA_s": 0.12,
        "GAP_MULETA_s": 0.15,
        "MARGEM_IA_s": 0.08,
        "MIN_PECA_s": 0.8,
        "ZOOM_ESCALA": 1.12,
        "ZOOM_MAX": 1.33,
        "ZOOM_ORIGEM_sem_rosto": "50% 38%",
        "ZOOM_SEGURA_MIN_s": 1.0
      },
      "detalhe": "in = 1.ª palavra − 0,06 s; out = última palavra + max(0,08; pausa da linha); pausa interna > 0,25 s fica 0,12 s; zoom alterna 1.00 ↔ 1.12 nos cortes com origem no rosto (Haar OpenCV)",
      "fonte": "edl.py linhas 30–51; common.py linhas 255–257"
    },
    {
      "passo": 6,
      "nome": "Aprovação humana",
      "script": null,
      "sai": "edl.json.aprovado = true",
      "detalhe": "regra rígida 1 (CLAUDE.md)"
    },
    {
      "passo": 7,
      "nome": "Render do corte",
      "script": "corte-por-roteiro/scripts/render_corte.py",
      "sai": "corte.mp4 (1080×1920, 10-bit V-Log) + corte-audio.wav",
      "parametros": {
        "ALCA_s": 0.015,
        "XFADE_s": 0.03
      },
      "detalhe": "peças na grade de frames; recorte no 1440 + lanczos",
      "fonte": "render_corte.py"
    },
    {
      "passo": 8,
      "nome": "Filmstrip",
      "script": "corte-por-roteiro/scripts/filmstrip.py",
      "sai": "edicao/frames/corte-NN.png",
      "parametros": {
        "OFFS_s": [
          -0.2,
          -0.1,
          0.0,
          0.1,
          0.2
        ],
        "ONDA_s": 0.5
      },
      "fonte": "filmstrip.py"
    },
    {
      "passo": 9,
      "nome": "Verificação",
      "script": "corte-por-roteiro/scripts/verify.py",
      "sai": "qa/diff.md",
      "parametros": {
        "WER_MAX": 0.08,
        "VOZ_IA_MAX_s": 0.2,
        "AV_tolerancia": "1 frame"
      },
      "fonte": "verify.py"
    },
    {
      "passo": 10,
      "nome": "Cor",
      "script": "color-grading/scripts/aplicar_cor.py",
      "sai": "edicao/cor/corte-cor.mp4 (H.264 CRF 16, yuv420p bt709)",
      "parametros": {
        "MAX_STOPS": 0.5,
        "MAX_CANAL": 0.08,
        "grao_padrao": 0.0
      },
      "detalhe": "16 bits: [V-Log→Rec.709 só câmera vlog] → primária por take (alvo_primaria do JSON da LUT) → LUT da marca (lut3d tetraédrica) → yuv420p bt709 (+ grão)",
      "fonte": "aplicar_cor.py"
    },
    {
      "passo": 11,
      "nome": "Remotion",
      "script": "legendas-animadas/scripts/gerar_props.py + render_reel.py",
      "sai": "render-remotion.mp4 (h264 CRF 18, yuv420p, bt709)",
      "detalhe": "legendas do texto do roteiro; extras split/full/card; cartão do CTA",
      "fonte": "render_reel.py; docs/contratos.md §6–7"
    },
    {
      "passo": 12,
      "nome": "Áudio",
      "script": "audio-polish/scripts/audio.py",
      "sai": "final.mp4",
      "parametros": {
        "RAZAO": 1.5,
        "LIMIAR_REL_dB": 9.0,
        "ATAQUE_ms": 30,
        "RELEASE_ms": 300,
        "LUFS": -14,
        "TP_dBTP": -1.5,
        "MARGEM_TP_dB": 0.3,
        "TOL_LUFS": 0.3,
        "BITRATE": "256k",
        "passadas_max": 4,
        "musica_db": -22,
        "ducking": "sidechaincompress threshold=0.05 ratio=8 attack=20 release=300",
        "fade_out_s": 1.5
      },
      "fonte": "audio.py linhas 41–50, 128–147, 186, 221–228"
    },
    {
      "passo": 13,
      "nome": "QA",
      "script": "qa-video/scripts/qa_check.py",
      "sai": "qa/qa-tecnico.json",
      "parametros": {
        "resolucao": "1080×1920",
        "fps": "FPS_PROJETO ±0,01 (25)",
        "codec": "h264 High yuv420p",
        "audio": "aac 48 kHz",
        "duracao_s": [
          3,
          900
        ],
        "tamanho_max_mb": 300,
        "bitrate_max_mbps": 25,
        "lufs": "−14 ±1",
        "true_peak_max": -1.5
      },
      "fonte": "qa_check.py SPEC"
    },
    {
      "passo": 14,
      "nome": "Pacote",
      "script": "scripts/montar_pacote.py",
      "sai": "05-render-pronto/<slug>/ + selo GAUNTLET"
    }
  ],
